# Copy to /etc/tori/tori.env; replace values; chmod 600, never commit real keys.
APCA_API_KEY_ID=replace-me
APCA_API_SECRET_KEY=replace-me
# Host exactly as opened in the browser, including port; no URL scheme.
TORI_ALLOWED_HOST=tori.internal:8765
# Generate a long random value. Browser: username tori, password this token.
# Hermes HTTP tools: Authorization: Bearer <token>. Prefer TLS via internal proxy.
TORI_API_TOKEN=replace-with-a-long-random-token
# Initial daily MSFT/AMZN research schedule, only if no saved schedule exists.
TORI_AUTO_ENABLED=1
